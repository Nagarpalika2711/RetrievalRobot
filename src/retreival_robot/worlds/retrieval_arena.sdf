<?xml version="1.0"?>
<sdf version="1.9">
  <world name="retrieval_arena">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.8 0.85 0.9 1</background>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.4 -0.3 -1</direction>
    </light>
    <model name="arena_floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision"><geometry><box><size>150 100 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>150 100 0.2</size></box></geometry><material><ambient>0.45 0.55 0.45 1</ambient><diffuse>0.5 0.6 0.5 1</diffuse></material></visual>
        <pose>0 0 -0.1 0 0 0</pose>
      </link>
    </model>
    <model name="arena_walls">
      <static>true</static>
      <link name="walls">
        <collision name="north_collision"><pose>0 50 1.5 0 0 0</pose><geometry><box><size>150 0.3 3</size></box></geometry></collision>
        <visual name="north_visual"><pose>0 50 1.5 0 0 0</pose><geometry><box><size>150 0.3 3</size></box></geometry><material><ambient>0.3 0.4 0.7 1</ambient><diffuse>0.3 0.4 0.7 1</diffuse></material></visual>
        <collision name="south_collision"><pose>0 -50 1.5 0 0 0</pose><geometry><box><size>150 0.3 3</size></box></geometry></collision>
        <visual name="south_visual"><pose>0 -50 1.5 0 0 0</pose><geometry><box><size>150 0.3 3</size></box></geometry><material><ambient>0.3 0.4 0.7 1</ambient><diffuse>0.3 0.4 0.7 1</diffuse></material></visual>
        <collision name="east_collision"><pose>75 0 1.5 0 0 0</pose><geometry><box><size>0.3 100 3</size></box></geometry></collision>
        <visual name="east_visual"><pose>75 0 1.5 0 0 0</pose><geometry><box><size>0.3 100 3</size></box></geometry><material><ambient>0.3 0.4 0.7 1</ambient><diffuse>0.3 0.4 0.7 1</diffuse></material></visual>
        <collision name="west_collision"><pose>-75 0 1.5 0 0 0</pose><geometry><box><size>0.3 100 3</size></box></geometry></collision>
        <visual name="west_visual"><pose>-75 0 1.5 0 0 0</pose><geometry><box><size>0.3 100 3</size></box></geometry><material><ambient>0.3 0.4 0.7 1</ambient><diffuse>0.3 0.4 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="retrieval_ball">
      <pose>2 0 0.09 0 0 0</pose>
      <static>false</static>
      <link name="ball_link">
        <inertial><mass>0.43</mass><inertia><ixx>0.0013932</ixx><iyy>0.0013932</iyy><izz>0.0013932</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.09</radius></sphere></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.09</radius></sphere></geometry>
          <material><ambient>0.95 0.25 0.05 1</ambient><diffuse>1 0.35 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
