<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="retreival_robot">

  <!-- ====================================================== -->
  <!--                       BASE LINK                        -->
  <!-- ====================================================== -->

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia
        ixx="0.000001"
        ixy="0"
        ixz="0"
        iyy="0.000001"
        iyz="0"
        izz="0.000001"/>
    </inertial>
  </link>


  <!-- ====================================================== -->
  <!--                 BASE TO CAD ASSEMBLY                   -->
  <!-- ====================================================== -->

  <joint name="base_to_chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>

    <origin xyz="0 0 0"
            rpy="1.570796 0 0"/>
  </joint>


  <!-- ====================================================== -->
  <!--                       CHASSIS                          -->
  <!-- ====================================================== -->

  <link name="chassis_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Chasis_Chassis_new.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Chasis_Chassis_new.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia
        ixx="0.60"
        ixy="0"
        ixz="0"
        iyy="0.60"
        iyz="0"
        izz="0.60"/>
    </inertial>

  </link>


  <!-- ====================================================== -->
  <!--                    LEFT DRIVE WHEEL                    -->
  <!-- ====================================================== -->

  <link name="left_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Wheel_left.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Wheel_left.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.008"
        ixy="0"
        ixz="0"
        iyy="0.008"
        iyz="0"
        izz="0.008"/>
    </inertial>

  </link>

  <joint name="left_wheel_joint" type="continuous">

    <parent link="chassis_link"/>
    <child link="left_wheel_link"/>

    <origin xyz="0.15 0.0725 0.38"
            rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>


  <!-- ====================================================== -->
  <!--                   RIGHT DRIVE WHEEL                    -->
  <!-- ====================================================== -->

  <link name="right_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Wheel_right.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Wheel_right.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.008"
        ixy="0"
        ixz="0"
        iyy="0.008"
        iyz="0"
        izz="0.008"/>
    </inertial>

  </link>

  <joint name="right_wheel_joint" type="continuous">

    <parent link="chassis_link"/>
    <child link="right_wheel_link"/>

    <origin xyz="0.15 0.0725 -0.38"
            rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>


  <!-- ====================================================== -->
  <!--                       CASTER 1                         -->
  <!-- ====================================================== -->

  <link name="caster_1_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/caster_1.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/caster_1.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia
        ixx="0.0005"
        ixy="0"
        ixz="0"
        iyy="0.0005"
        iyz="0"
        izz="0.0005"/>
    </inertial>

  </link>

  <joint name="caster_1_joint" type="fixed">

    <parent link="chassis_link"/>
    <child link="caster_1_link"/>

    <origin xyz="-0.11496 0 0.27908"
            rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!--                       CASTER 2                         -->
  <!-- ====================================================== -->

  <link name="caster_2_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/caster_2.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/caster_2.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia
        ixx="0.0005"
        ixy="0"
        ixz="0"
        iyy="0.0005"
        iyz="0"
        izz="0.0005"/>
    </inertial>

  </link>

  <joint name="caster_2_joint" type="fixed">

    <parent link="chassis_link"/>
    <child link="caster_2_link"/>

    <origin xyz="-0.11496 0 -0.27908"
            rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!--                       CASTER 3                         -->
  <!-- ====================================================== -->

  <link name="caster_3_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/caster_3.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/caster_3.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia
        ixx="0.0005"
        ixy="0"
        ixz="0"
        iyy="0.0005"
        iyz="0"
        izz="0.0005"/>
    </inertial>

  </link>

  <joint name="caster_3_joint" type="fixed">

    <parent link="chassis_link"/>
    <child link="caster_3_link"/>

    <origin xyz="0.41496 0 0.27908"
            rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!--                       CASTER 4                         -->
  <!-- ====================================================== -->

  <link name="caster_4_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/caster_4.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/caster_4.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia
        ixx="0.0005"
        ixy="0"
        ixz="0"
        iyy="0.0005"
        iyz="0"
        izz="0.0005"/>
    </inertial>

  </link>

  <joint name="caster_4_joint" type="fixed">

    <parent link="chassis_link"/>
    <child link="caster_4_link"/>

    <origin xyz="0.41496 0 -0.27908"
            rpy="0 0 0"/>

  </joint>


  <!-- ====================================================== -->
  <!--                 RIGHT FRONT GRIPPER                    -->
  <!-- ====================================================== -->

  <link name="gripper_right_front_link">

    <visual>
      <origin xyz="0 0 0"
              rpy="0 3.14159265359 3.14159265359"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Gripper_left_front.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"
              rpy="0 3.14159265359 3.14159265359"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Gripper_left_front.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"
              rpy="0 3.14159265359 3.14159265359"/>
      <mass value="0.25"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="gripper_right_front_joint" type="revolute">

    <parent link="chassis_link"/>
    <child link="gripper_right_front_link"/>

    <!-- Right front joint lowered by 5 cm in chassis Y -->
    <origin xyz="0.350 0.07973 -0.180"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <!-- CLOSED = 0, OPEN = +0.540 -->
    <limit
      lower="0.0"
      upper="0.540"
      effort="10.0"
      velocity="1.0"/>

  </joint>


  <!-- ====================================================== -->
  <!--                  LEFT FRONT GRIPPER                    -->
  <!-- ====================================================== -->

  <link name="gripper_left_front_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Gripper_left_front.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Gripper_left_front.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="gripper_left_front_joint" type="revolute">

    <parent link="chassis_link"/>
    <child link="gripper_left_front_link"/>

    <origin xyz="0.350 0.12973 0.180"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <!-- CLOSED = 0, OPEN = -0.540 -->
    <limit
      lower="-0.540"
      upper="0.0"
      effort="10.0"
      velocity="1.0"/>

  </joint>


  <!-- ====================================================== -->
  <!--                  RIGHT BACK GRIPPER                    -->
  <!-- ====================================================== -->

  <link name="gripper_right_back_link">

    <visual>
      <origin xyz="0 0 0"
              rpy="0 3.14159265359 3.14159265359"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Gripper_left_back.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"
              rpy="0 3.14159265359 3.14159265359"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Gripper_left_back.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"
              rpy="0 3.14159265359 3.14159265359"/>
      <mass value="0.25"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="gripper_right_back_joint" type="revolute">

    <parent link="chassis_link"/>
    <child link="gripper_right_back_link"/>

    <!-- Right back joint lowered by 5 cm in chassis Y -->
    <origin xyz="0.310 0.07973 -0.180"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <!-- CLOSED = 0, OPEN = -0.540 -->
    <limit
      lower="-0.540"
      upper="0.0"
      effort="10.0"
      velocity="1.0"/>

  </joint>


  <!-- ====================================================== -->
  <!--                   LEFT BACK GRIPPER                    -->
  <!-- ====================================================== -->

  <link name="gripper_left_back_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Gripper_left_back.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://retreival_robot/meshes/Gripper_left_back.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="gripper_left_back_joint" type="revolute">

    <parent link="chassis_link"/>
    <child link="gripper_left_back_link"/>

    <origin xyz="0.310 0.12973 0.180"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <!-- CLOSED = 0, OPEN = +0.540 -->
    <limit
      lower="0.0"
      upper="0.540"
      effort="10.0"
      velocity="1.0"/>

  </joint>






<!-- RGB-D CAMERA LINK -->
<link name="camera_link">
  <visual>
    <geometry>
      <box size="0.04 0.06 0.04"/>
    </geometry>
    <material name="camera_black">
      <color rgba="0.1 0.1 0.1 1.0"/>
    </material>
  </visual>

  <collision>
    <geometry>
      <box size="0.04 0.06 0.04"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.05"/>
    <inertia ixx="0.0000217" ixy="0" ixz="0"
             iyy="0.0000133" iyz="0"
             izz="0.0000217"/>
  </inertial>
</link>

<!-- FIX CAMERA TO CHASSIS -->
<joint name="chassis_to_camera_joint" type="fixed">
  <parent link="chassis_link"/>
  <child link="camera_link"/>

  <!-- Position in meters, relative to chassis_link -->
  <origin xyz="-0.190 0.275 0.000" rpy="0 3.141592653589793 0"/>
</joint>

<!-- GAZEBO SIM RGB-D CAMERA -->
<gazebo reference="camera_link">
  <sensor name="rgbd_camera" type="rgbd_camera">
    <always_on>true</always_on>
    <update_rate>30</update_rate>
    <visualize>true</visualize>

    <topic>camera</topic>

    <camera>
      <horizontal_fov>1.047</horizontal_fov>

      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.1</near>
        <far>10.0</far>
      </clip>

      <depth_camera>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </depth_camera>
    </camera>
  </sensor>
</gazebo>


  <!-- ====================================================== -->
  <!--                    ROS 2 CONTROL                       -->
  <!-- ====================================================== -->

  <ros2_control name="GazeboSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- LEFT WHEEL VELOCITY CONTROL -->
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- RIGHT WHEEL VELOCITY CONTROL -->
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- RIGHT FRONT GRIPPER POSITION CONTROL -->
    <joint name="gripper_right_front_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- LEFT FRONT GRIPPER POSITION CONTROL -->
    <joint name="gripper_left_front_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- RIGHT BACK GRIPPER POSITION CONTROL -->
    <joint name="gripper_right_back_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- LEFT BACK GRIPPER POSITION CONTROL -->
    <joint name="gripper_left_back_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>


  <!-- ====================================================== -->
  <!--              GAZEBO ROS 2 CONTROL PLUGIN               -->
  <!-- ====================================================== -->

  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>$(find retreival_robot)/config/controllers.yaml</parameters>

    </plugin>
  </gazebo>


  <!-- ====================================================== -->
  <!--                   WHEEL TRACTION                       -->
  <!-- ====================================================== -->

  <gazebo reference="left_wheel_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

</robot>