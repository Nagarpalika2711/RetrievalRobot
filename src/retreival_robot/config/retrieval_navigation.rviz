
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /PointCloud21
        - /Cylinder Detections1
        - /Planned Path1
      Splitter Ratio: 0.5
    Tree Height: 600

Visualization Manager:
  Class: ""
  Enabled: true
  Name: root

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Displays:

    # =========================================
    # GRID
    # =========================================

    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.35
      Cell Size: 1
      Color: 160; 160; 160
      Line Style:
        Value: Lines
        Line Width: 0.03
      Normal Cell Count: 100
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: map

    # =========================================
    # OCCUPANCY MAP
    # =========================================

    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.85
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 5
      Update Topic:
        Value: /map_updates
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Use Timestamp: false

    # =========================================
    # RGB-D CAMERA POINT CLOUD
    # =========================================

    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloud2
      Enabled: true
      Topic:
        Value: /camera/points
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Alpha: 1
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds:
        Min Value: -1
        Max Value: 5
        Value: true
      Channel Name: intensity
      Decay Time: 0
      Invert Rainbow: false
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.05
      Style: Points
      Use Fixed Frame: true
      Use rainbow: true

    # =========================================
    # DETECTED CYLINDER MARKERS
    # =========================================

    - Class: rviz_default_plugins/MarkerArray
      Name: Cylinder Detections
      Enabled: true
      Marker Topic:
        Value: /viz/detections
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Namespaces:
        cylinders: true
      Queue Size: 100

    # =========================================
    # A* PLANNED PATH
    # =========================================

    - Class: rviz_default_plugins/Path
      Name: Planned Path
      Enabled: true
      Topic:
        Value: /planned_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 5
      Alpha: 1
      Color: 255; 80; 20
      Line Style: Lines
      Line Width: 0.12
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0.12
      Pose Style: None

    # =========================================
    # ROBOT MODEL
    # =========================================

    - Class: rviz_default_plugins/RobotModel
      Name: Robot Model
      Enabled: true
      Alpha: 1
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 5

    # =========================================
    # TF FRAMES
    # =========================================

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 1
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure

  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Angle: 0
      Scale: 8
      X: 0
      Y: 0
    Saved: []

Window Geometry:
  Width: 1400
  Height: 900
  X: 100
  Y: 100
